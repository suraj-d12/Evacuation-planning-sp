global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'evacuation_planner'
    static_configs:
      - targets: ['localhost:8000']  # Assuming the app runs on port 8000

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['localhost:9100']  # For system metrics

  - job_name: 'postgres_exporter'
    static_configs:
      - targets: ['localhost:9187']  # For PostgreSQL metrics

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - 'localhost:9093'  # Assuming AlertManager runs on this port

rule_files:
  - 'alert_rules.yml'  # Create this file for custom alerting rules
